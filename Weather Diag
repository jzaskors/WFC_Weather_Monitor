    now = datetime.now().strftime("%a %b %d, %Y at %-I:%M %p")

    rows = []
    for p in probes:
        win = p is active
        rows.append(f"""
        <tr style="background:{'#e8f5e9' if win else '#fff'}">
          <td style="padding:9px 10px;border-bottom:1px solid #e0e0e0;font-size:13px">
            {'&#9654; ' if win else ''}<strong>{p.name}</strong>
            <div style="color:#757575;font-size:11px">{p.tier}
            {f'&middot; {p.distance_mi:.1f} mi' if p.distance_mi is not None else ''}</div>
          </td>
          <td style="padding:9px 10px;border-bottom:1px solid #e0e0e0;font-size:13px;
              font-weight:700;color:{STATUS_COLOR.get(p.status,'#000')}">{p.status}</td>
          <td style="padding:9px 10px;border-bottom:1px solid #e0e0e0;font-size:13px;
              font-family:monospace">{p.reading()}</td>
          <td style="padding:9px 10px;border-bottom:1px solid #e0e0e0;font-size:13px">
            {f'{p.age_min:.0f} min' if p.age_min is not None else '&mdash;'}</td>
          <td style="padding:9px 10px;border-bottom:1px solid #e0e0e0;font-size:13px">
            {f'{p.latency_ms} ms' if p.latency_ms is not None else '&mdash;'}</td>
          <td style="padding:9px 10px;border-bottom:1px solid #e0e0e0;font-size:11px;
              color:#616161;max-width:280px;word-break:break-word">{p.detail or '&mdash;'}</td>
        </tr>""")

    if active is None:
        banner = ('<div style="background:#c62828;color:#fff;padding:14px;border-radius:6px;'
                  'font-weight:700">NO USABLE SOURCE &mdash; the monitor cannot make a call.</div>')
    elif active.tier == "PRIMARY":
        banner = (f'<div style="background:#2e7d32;color:#fff;padding:14px;border-radius:6px">'
                  f'<strong>Driving the call: {active.name}</strong><br>'
                  f'<span style="font-size:13px">Primary source healthy.</span></div>')
    else:
        banner = (f'<div style="background:#ef6c00;color:#fff;padding:14px;border-radius:6px">'
                  f'<strong>FALLBACK IN USE: {active.name}</strong><br>'
                  f'<span style="font-size:13px">Sagamore is not answering. This reading is '
                  f'{active.distance_mi:.0f} mi away and may not reflect West Harbor.</span></div>')

    notes_html = "".join(
        f'<li style="margin-bottom:5px">{n}</li>' for n in notes) or "<li>None</li>"

    env_rows = "".join(
        f'<tr><td style="padding:4px 10px;font-family:monospace;font-size:12px">{k}</td>'
        f'<td style="padding:4px 10px;font-size:12px;color:'
        f'{"#2e7d32" if os.environ.get(k) else "#c62828"}">'
        f'{"set" if os.environ.get(k) else "NOT SET"}</td></tr>'
        for k in ("WEATHERLINK_API_KEY", "WEATHERLINK_API_SECRET", "SYC_WL_STATION_ID",
                  "SYC_EMBED_UUID", "BREVO_SMTP_USER", "BREVO_SMTP_KEY"))

    limits = "".join(
        f'<tr><td style="padding:4px 10px;font-size:12px">{c}</td>'
        f'<td style="padding:4px 10px;font-size:12px">caution &ge; {v["caution"]} kn</td>'
        f'<td style="padding:4px 10px;font-size:12px">no-go &ge; {v["stop"]} kn</td></tr>'
        for c, v in FLEET_LIMITS.items())

    return f"""<!doctype html><html><body style="margin:0;padding:0;background:#f5f5f5">
<div style="max-width:760px;margin:0 auto;padding:18px;
     font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif">

  <div style="background:#4527a0;color:#fff;padding:16px;border-radius:6px;margin-bottom:16px">
    <div style="font-size:19px;font-weight:800;letter-spacing:.5px">DIAGNOSTIC &mdash; NOT AN ALERT</div>
    <div style="font-size:13px;margin-top:5px;opacity:.9">
      Source provenance test for the WFC weather monitor. Do not act on this email.
      Generated {now}.</div>
  </div>

  {banner}

  <h2 style="font-size:15px;margin:24px 0 8px;color:#333">Current graphic</h2>
  <img src="cid:conditions" width="100%" style="max-width:720px;border-radius:8px;display:block">

  <h2 style="font-size:15px;margin:24px 0 8px;color:#333">Every source probed</h2>
  <table style="width:100%;border-collapse:collapse;background:#fff;border-radius:6px;
         overflow:hidden;border:1px solid #e0e0e0">
    <tr style="background:#eceff1">
      <th style="padding:9px 10px;text-align:left;font-size:11px;color:#546e7a">SOURCE</th>
      <th style="padding:9px 10px;text-align:left;font-size:11px;color:#546e7a">STATUS</th>
      <th style="padding:9px 10px;text-align:left;font-size:11px;color:#546e7a">READING</th>
      <th style="padding:9px 10px;text-align:left;font-size:11px;color:#546e7a">AGE</th>
      <th style="padding:9px 10px;text-align:left;font-size:11px;color:#546e7a">LATENCY</th>
      <th style="padding:9px 10px;text-align:left;font-size:11px;color:#546e7a">DETAIL</th>
    </tr>
    {''.join(rows)}
  </table>

  <h2 style="font-size:15px;margin:24px 0 8px;color:#333">Tier resolution log</h2>
  <ul style="font-size:12.5px;color:#424242;background:#fff;padding:14px 14px 14px 30px;
      border-radius:6px;border:1px solid #e0e0e0;margin:0">{notes_html}</ul>

  <h2 style="font-size:15px;margin:24px 0 8px;color:#333">Thresholds in use</h2>
  <table style="width:100%;border-collapse:collapse;background:#fff;border:1px solid #e0e0e0;
         border-radius:6px">{limits}</table>
  <p style="font-size:11.5px;color:#c62828;margin:7px 0 0">
    These are placeholder limits from the script, not your production values.
    Reconcile them with the monitor before reading anything into the fleet column.</p>

  <h2 style="font-size:15px;margin:24px 0 8px;color:#333">Credentials visible to this run</h2>
  <table style="width:100%;border-collapse:collapse;background:#fff;border:1px solid #e0e0e0;
         border-radius:6px">{env_rows}</table>
  <p style="font-size:11.5px;color:#757575;margin:7px 0 0">
    Presence only &mdash; no values are read or transmitted.</p>

  <p style="font-size:11.5px;color:#9e9e9e;margin-top:26px;border-top:1px solid #e0e0e0;
     padding-top:12px">
    Diagnostic output. Confirm lightning by eye and ear and apply the 30-30 rule.
    This assists the call; it does not make it.</p>
</div></body></html>"""


# ---------------------------------------------------------------------------
# SEND
# ---------------------------------------------------------------------------

def send_email(html: str, png: bytes, active: Probe | None) -> None:
    user, key = os.environ.get("BREVO_SMTP_USER"), os.environ.get("BREVO_SMTP_KEY")
    to, frm = os.environ.get("WFC_DIAG_TO"), os.environ.get("WFC_DIAG_FROM")
    missing = [n for n, v in (("BREVO_SMTP_USER", user), ("BREVO_SMTP_KEY", key),
                              ("WFC_DIAG_TO", to), ("WFC_DIAG_FROM", frm)) if not v]
    if missing:
        raise SystemExit("Cannot send, missing env: " + ", ".join(missing))

    tag = active.tier if active else "NO SOURCE"
    msg = EmailMessage()
    msg["Subject"] = f"[DIAGNOSTIC] WFC weather sources \u2014 {tag}"
    msg["From"], msg["To"] = frm, to
    msg["X-WFC-Diagnostic"] = "true"
    msg.set_content(
        "Diagnostic output from the WFC weather monitor. Not an operational alert. "
        "View in an HTML-capable client.")
    msg.add_alternative(html, subtype="html")
    msg.get_payload()[1].add_related(
        png, "image", "png", cid="<conditions>", filename="conditions.png")

    with smtplib.SMTP(BREVO_HOST, BREVO_PORT, timeout=30) as s:
        s.starttls()
        s.login(user, key)
        s.send_message(msg)
    print(f"Sent to {to}")


# ---------------------------------------------------------------------------

def main() -> int:
    ap = argparse.ArgumentParser()
    ap.add_argument("--send", action="store_true", help="email it (default: preview only)")
    ap.add_argument("--out", default="diag_preview.html")
    args = ap.parse_args()

    print("Probing sources...\n")
    probes = run_probes()
    active, notes = select_active(probes)

    w = max(len(p.name) for p in probes)
    for p in probes:
        mark = "->" if p is active else "  "
        print(f"{mark} {p.name:<{w}}  {p.status:<15} {p.reading():<22} {p.detail[:60]}")
    print()

    png = render_graphic(active)
    html = render_html(probes, active, notes)

    with open(args.out, "w") as f:
        f.write(html.replace('src="cid:conditions"',
                             'src="data:image/png;base64,' +
                             base64.b64encode(png).decode() + '"'))
    print(f"Preview written to {args.out}")

    if args.send:
        send_email(html, png, active)
    else:
        print("Not sent. Re-run with --send to email it.")

    return 0 if active and active.tier == "PRIMARY" else 1


if __name__ == "__main__":
    try:
        sys.exit(main())
    except Exception:
        traceback.print_exc()
        sys.exit(2)
