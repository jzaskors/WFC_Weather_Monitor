#!/usr/bin/env python3
"""
weather_diag.py — WFC weather system diagnostic email.

Renders the current conditions graphic AND a full provenance panel showing every
configured source: which ones answered, how old their data is, how long they took,
and which one is actually driving the fleet call.

This is a TEST tool. It sends to WFC_DIAG_TO only, prefixes the subject with
[DIAGNOSTIC], and stamps a banner on the email so it can never be mistaken for an
operational alert. It does not touch the ops distribution list.

    python3 weather_diag.py                # probe + write HTML preview, no send
    python3 weather_diag.py --send         # probe + email it
    python3 weather_diag.py --out /tmp/x.html

Env:
    BREVO_SMTP_USER, BREVO_SMTP_KEY, WFC_DIAG_FROM, WFC_DIAG_TO
    WEATHERLINK_API_KEY, WEATHERLINK_API_SECRET, SYC_WL_STATION_ID, SYC_EMBED_UUID
"""

from __future__ import annotations

import argparse
import base64
import io
import math
import os
import smtplib
import sys
import time
import traceback
from dataclasses import dataclass, field
from datetime import datetime, timezone
from email.message import EmailMessage
from typing import Any, Callable

import requests

# ---------------------------------------------------------------------------
# CONFIG
# ---------------------------------------------------------------------------

WFC_LAT, WFC_LON = 40.8846, -73.5307        # West Harbor, Oyster Bay
TIMEOUT = 12

# !!! PLACEHOLDER THRESHOLDS — replace with the real numbers from your monitor
# before you trust anything this prints. Gust knots.
FLEET_LIMITS = {
    "Kayaks":       {"caution": 12, "stop": 18},
    "Paddleboards": {"caution": 12, "stop": 16},
    "Sonars":       {"caution": 20, "stop": 28},
}

# Offshore (wind blowing away from the beach) sector for West Harbor, degrees FROM.
OFFSHORE_FROM, OFFSHORE_TO = 150, 240

BREVO_HOST, BREVO_PORT = "smtp-relay.brevo.com", 587


# ---------------------------------------------------------------------------
# PROBE MODEL
# ---------------------------------------------------------------------------

@dataclass
class Probe:
    name: str
    tier: str                     # "PRIMARY" | "BACKUP" | "FORECAST"
    distance_mi: float | None = None
    status: str = "PENDING"       # OK | STALE | ERROR | NOT CONFIGURED
    wind_kn: float | None = None
    gust_kn: float | None = None
    wind_dir_deg: int | None = None
    age_min: float | None = None
    latency_ms: int | None = None
    detail: str = ""
    endpoint: str = ""

    @property
    def usable(self) -> bool:
        return self.status == "OK" and self.gust_kn is not None

    def reading(self) -> str:
        if self.wind_kn is None:
            return "\u2014"
        s = f"{self.wind_kn:.0f} kn"
        if self.gust_kn is not None:
            s += f" g{self.gust_kn:.0f}"
        if self.wind_dir_deg is not None:
            s += f" @ {self.wind_dir_deg:03d}\u00b0"
        return s


def timed(fn: Callable[[], Any]) -> tuple[Any, int]:
    t0 = time.monotonic()
    out = fn()
    return out, int((time.monotonic() - t0) * 1000)


# ---------------------------------------------------------------------------
# SOURCES
# ---------------------------------------------------------------------------

def probe_sagamore() -> Probe:
    p = Probe("Sagamore YC (WeatherLink)", "PRIMARY", 0.2)
    p.endpoint = "weatherlink.com \u2014 v2 API, embed fallback"
    try:
        import sagamore
    except ImportError:
        p.status = "ERROR"
        p.detail = "sagamore.py not importable from this directory"
        return p
    try:
        obs, ms = timed(sagamore.fetch_sagamore)
        p.latency_ms = ms
        p.status = "OK"
        p.wind_kn, p.gust_kn = obs.wind_kn, obs.gust_kn
        p.wind_dir_deg, p.age_min = obs.wind_dir_deg, obs.age_min
        p.detail = f"backend={obs.backend}"
    except Exception as e:
        p.status = "ERROR"
        p.detail = str(e)[:400]
    return p


def probe_ndbc(station: str, label: str, dist: float) -> Probe:
    p = Probe(f"NDBC {station} ({label})", "BACKUP", dist)
    url = f"https://www.ndbc.noaa.gov/data/realtime2/{station}.txt"
    p.endpoint = url
    try:
        r, ms = timed(lambda: requests.get(url, timeout=TIMEOUT))
        p.latency_ms = ms
        r.raise_for_status()
        lines = [l for l in r.text.splitlines() if l and not l.startswith("#")]
        if not lines:
            p.status, p.detail = "ERROR", "no data rows"
            return p
        f = lines[0].split()
        obs_t = datetime(int(f[0]), int(f[1]), int(f[2]), int(f[3]), int(f[4]), tzinfo=timezone.utc)
        p.age_min = (datetime.now(timezone.utc) - obs_t).total_seconds() / 60

        def num(v):
            return None if v in ("MM", "999", "99.0") else float(v)

        wdir, wspd, gst = num(f[5]), num(f[6]), num(f[7])
        p.wind_dir_deg = int(wdir) if wdir is not None else None
        p.wind_kn = wspd * 1.94384 if wspd is not None else None   # m/s -> kn
        p.gust_kn = gst * 1.94384 if gst is not None else None
        p.status = "OK" if p.age_min <= 90 else "STALE"
        if p.status == "STALE":
            p.detail = f"{p.age_min:.0f} min old"
    except Exception as e:
        p.status, p.detail = "ERROR", str(e)[:400]
    return p


def probe_nws(station: str, label: str, dist: float) -> Probe:
    p = Probe(f"NWS {station} ({label})", "BACKUP", dist)
    url = f"https://api.weather.gov/stations/{station}/observations/latest"
    p.endpoint = url
    try:
        r, ms = timed(lambda: requests.get(
            url, timeout=TIMEOUT,
            headers={"User-Agent": "WFC-weather-monitor (waterfront safety)"}))
        p.latency_ms = ms
        r.raise_for_status()
        props = r.json()["properties"]
        obs_t = datetime.fromisoformat(props["timestamp"].replace("Z", "+00:00"))
        p.age_min = (datetime.now(timezone.utc) - obs_t).total_seconds() / 60

        def val(k):
            v = (props.get(k) or {}).get("value")
            return float(v) if v is not None else None

        ws, wg, wd = val("windSpeed"), val("windGust"), val("windDirection")
        p.wind_kn = ws * 0.539957 if ws is not None else None      # km/h -> kn
        p.gust_kn = wg * 0.539957 if wg is not None else None
        p.wind_dir_deg = int(wd) if wd is not None else None
        p.status = "OK" if p.age_min <= 90 else "STALE"
        if p.status == "STALE":
            p.detail = f"{p.age_min:.0f} min old"
    except Exception as e:
        p.status, p.detail = "ERROR", str(e)[:400]
    return p


def probe_open_meteo() -> Probe:
    p = Probe("Open-Meteo (forecast)", "FORECAST", 0.0)
    url = "https://api.open-meteo.com/v1/forecast"
    p.endpoint = url
    try:
        r, ms = timed(lambda: requests.get(url, timeout=TIMEOUT, params={
            "latitude": WFC_LAT, "longitude": WFC_LON,
            "current": "wind_speed_10m,wind_gusts_10m,wind_direction_10m",
            "wind_speed_unit": "kn", "models": "best_match",
        }))
        p.latency_ms = ms
        r.raise_for_status()
        c = r.json()["current"]
        p.wind_kn = c.get("wind_speed_10m")
        p.gust_kn = c.get("wind_gusts_10m")
        wd = c.get("wind_direction_10m")
        p.wind_dir_deg = int(wd) if wd is not None else None
        p.age_min = 0.0
        p.status = "OK"
        p.detail = "model output, not an observation"
    except Exception as e:
        p.status, p.detail = "ERROR", str(e)[:400]
    return p


def run_probes() -> list[Probe]:
    return [
        probe_sagamore(),
        probe_nws("KLGA", "LaGuardia", 18.0),
        probe_ndbc("44040", "Western LI Sound", 12.0),
        probe_open_meteo(),
    ]


def select_active(probes: list[Probe]) -> tuple[Probe | None, list[str]]:
    """Tier order: PRIMARY, then BACKUP, then FORECAST. Returns winner + notes."""
    notes = []
    for tier in ("PRIMARY", "BACKUP", "FORECAST"):
        for p in probes:
            if p.tier == tier and p.usable:
                if tier != "PRIMARY":
                    notes.append(
                        f"PRIMARY (Sagamore) unavailable \u2014 fell through to {tier}: {p.name}")
                return p, notes
        for p in probes:
            if p.tier == tier and not p.usable:
                notes.append(f"{tier} {p.name}: {p.status} \u2014 {p.detail or 'no detail'}")
    return None, notes


# ---------------------------------------------------------------------------
# GRAPHIC
# ---------------------------------------------------------------------------

BG, FG, MUTED, ACCENT = (13, 27, 48), (255, 255, 255), (140, 158, 184), (240, 176, 66)
GREEN, AMBER, RED = (74, 201, 126), (240, 176, 66), (232, 93, 93)


def fleet_status(gust: float | None) -> list[tuple[str, str, tuple]]:
    out = []
    for craft, lim in FLEET_LIMITS.items():
        if gust is None:
            out.append((craft, "NO DATA", MUTED))
        elif gust >= lim["stop"]:
            out.append((craft, "NO GO", RED))
        elif gust >= lim["caution"]:
            out.append((craft, "CAUTION", AMBER))
        else:
            out.append((craft, "GO", GREEN))
    return out


def render_graphic(active: Probe | None) -> bytes:
    """Compass + fleet card as PNG. PIL only — no cairo/system deps."""
    from PIL import Image, ImageDraw, ImageFont

    W, H, S = 1000, 460, 2                     # S = supersample for crisp text
    img = Image.new("RGB", (W * S, H * S), BG)
    d = ImageDraw.Draw(img)

    def font(sz, bold=False):
        paths = [
            "/usr/share/fonts/truetype/dejavu/DejaVuSans%s.ttf" % ("-Bold" if bold else ""),
        ]
        for p in paths:
            if os.path.exists(p):
                return ImageFont.truetype(p, sz * S)
        return ImageFont.load_default()

    d.text((28 * S, 20 * S), "WEST HARBOR CONDITIONS", font=font(21, True), fill=FG)
    src = active.name if active else "NO SOURCE AVAILABLE"
    d.text((28 * S, 50 * S), f"Source: {src}", font=font(13), fill=MUTED)

    # --- compass -----------------------------------------------------------
    cx, cy, R = 190 * S, 250 * S, 118 * S
    # offshore wedge (PIL angles: 0 = 3 o'clock, clockwise)
    d.pieslice([cx - R, cy - R, cx + R, cy + R],
               start=OFFSHORE_FROM - 90, end=OFFSHORE_TO - 90, fill=(60, 45, 18))
    for rad, col in ((R, (44, 62, 88)), (int(R * 0.62), (34, 50, 74))):
        d.ellipse([cx - rad, cy - rad, cx + rad, cy + rad], outline=col, width=2 * S)

    for lbl, ang in (("N", 0), ("E", 90), ("S", 180), ("W", 270)):
        a = math.radians(ang - 90)
        tx, ty = cx + (R + 22 * S) * math.cos(a), cy + (R + 22 * S) * math.sin(a)
        d.text((tx, ty), lbl, font=font(15, True), fill=FG, anchor="mm")

    if active and active.wind_dir_deg is not None:
        a = math.radians(active.wind_dir_deg - 90)   # direction wind comes FROM
        x0, y0 = cx + R * math.cos(a), cy + R * math.sin(a)
        x1, y1 = cx + R * 0.30 * math.cos(a), cy + R * 0.30 * math.sin(a)
        d.line([x0, y0, x1, y1], fill=FG, width=5 * S)
        hl = 13 * S
        for off in (140, -140):
            b = a + math.radians(off)
            d.line([x1, y1, x1 + hl * math.cos(b), y1 + hl * math.sin(b)], fill=FG, width=5 * S)

    spd = f"{active.wind_kn:.0f}" if active and active.wind_kn is not None else "--"
    d.text((cx, cy - 16 * S), spd, font=font(46, True), fill=FG, anchor="mm")
    d.text((cx, cy + 16 * S), "kn sustained", font=font(12), fill=MUTED, anchor="mm")
    if active and active.gust_kn is not None:
        d.text((cx, cy + 38 * S), f"gusts {active.gust_kn:.0f}",
               font=font(14, True), fill=ACCENT, anchor="mm")
    d.text((cx, cy + R + 46 * S), "OFFSHORE SECTOR", font=font(11, True),
           fill=ACCENT, anchor="mm")

    # --- fleet card --------------------------------------------------------
    px, py, pw, ph = 400 * S, 100 * S, 570 * S, 250 * S
    d.rounded_rectangle([px, py, px + pw, py + ph], radius=10 * S,
                        fill=(20, 38, 62), outline=(44, 62, 88), width=2 * S)
    d.text((px + 26 * S, py + 20 * S), "FLEET", font=font(13, True), fill=MUTED)
    d.text((px + pw - 26 * S, py + 20 * S), "STATUS", font=font(13, True),
           fill=MUTED, anchor="ra")

    gust = active.gust_kn if active else None
    for i, (craft, state, col) in enumerate(fleet_status(gust)):
        ry = py + 62 * S + i * 60 * S
        d.rectangle([px + 26 * S, ry, px + 30 * S, ry + 30 * S], fill=col)
        d.text((px + 46 * S, ry + 15 * S), craft, font=font(19), fill=FG, anchor="lm")
        d.text((px + pw - 26 * S, ry + 15 * S), state, font=font(18, True),
               fill=col, anchor="rm")

    d.text((28 * S, H * S - 34 * S),
           "Confirm lightning by eye and ear \u2014 30-30 rule. "
           "This graphic assists the call; it does not make it.",
           font=font(12), fill=MUTED)

    img = img.resize((W, H), Image.LANCZOS)
    buf = io.BytesIO()
    img.save(buf, "PNG")
    return buf.getvalue()


