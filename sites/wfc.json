    { "id": "oyster_bay_29", "type": "wunderground", "label": "Oyster Bay Station (1/4 mi SW)",
      "station": "KNYOYSTE29",
      "exposure_offset_kn": 0, "max_age_min": 20, "has_live_gust": true,
