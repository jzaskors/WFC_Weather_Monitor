{
  "schema_version": 1,
  "id": "wfc",
  "name": "The WaterFront Center",
  "short_name": "WFC",
  "area_name": "West Harbor",
  "location": { "lat": 40.876, "lon": -73.530 },
  "timezone": "America/New_York",
