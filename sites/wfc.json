    { "id": "sonars", "label": "Sonars",
      "limits": { "wind_caution": 16, "wind_stop": 22, "gust_caution": 22, "gust_stop": 28 } }
  ],

  "observation_sources": [
    { "id": "wfc_tempest", "type": "tempest", "label": "WFC dock (Tempest)",
      "station_id": 238215, "auth": "token",
      "exposure_offset_kn": 0, "max_age_min": 15, "has_live_gust": true,
      "enabled": true,
