  ],

  "shared_limits": {
    "rain_caution_in_hr": 0.10,
    "rain_stop_in_hr": 0.30,
    "cape_watch": 1000,
    "visibility_stop_mi": 0.5
  },

  "nws_marine_zones": ["ANZ335"],

  "nws_routing": {
    "stop": ["Tornado", "Special Marine", "Marine Warning", "Hurricane",
             "Tropical Storm", "Gale", "Storm Warning"],
    "caution": ["Thunderstorm"]
  },

  "activities": [
    {
      "id": "paddle",
      "label": "Kayak / SUP rentals",
      "limits": { "wind_caution": 12, "wind_stop": 16, "gust_caution": 16, "gust_stop": 20,
                  "offshore_caution": 8, "offshore_stop": 13 }
    },
    {
      "id": "sail",
      "label": "Sailing programs",
      "limits": { "wind_caution": 16, "wind_stop": 22, "gust_caution": 22, "gust_stop": 28 }
    }
  ],

  "fleet": [
    { "id": "kayaks", "label": "Kayaks",
      "limits": { "wind_caution": 12, "wind_stop": 16, "gust_caution": 16, "gust_stop": 20,
